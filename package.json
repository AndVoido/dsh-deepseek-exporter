{
  "name": "dsh-deepseek-exporter",
  "version": "0.1.0",
  "description": "Export DSH sessions to DeepSeek's official v3 ZIP format, from the dsh-go phone app or the DSH web client.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/feiyusea/dsh-deepseek-exporter.git"
  },
  "homepage": "https://github.com/feiyusea/dsh-deepseek-exporter#readme",
  "bugs": {
    "url": "https://github.com/feiyusea/dsh-deepseek-exporter/issues"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./export-core": "./lib/export-core.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "dsh-go",
    "deepseek",
    "export",
    "plugin"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "dshGo": {
    "v": 1,
    "minApp": "1.0.4",
    "title": {
      "zh": "导出到 DeepSeek 格式",
      "en": "Export to DeepSeek"
    },
    "icon": "downloads",
    "capabilities": [
      "files"
    ],
    "wants": [],
    "contributes": {
      "panels": [
        {
          "id": "deepseek-export",
          "title": {
            "zh": "导出到 DeepSeek 格式",
            "en": "DeepSeek export"
          },
          "icon": "downloads",
          "placement": [
            "features"
          ]
        }
      ]
    }
  },
  "engines": {
    "node": ">=22.19",
    "dsh": ">=0.2.1-rc.4 <0.3.0-0"
  }
}
